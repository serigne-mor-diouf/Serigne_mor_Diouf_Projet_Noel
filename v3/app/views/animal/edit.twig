{% extends "layout/base.twig" %}

{% block title %}Modifier l'Animal{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header">
        <h2>Modifier l'Animal</h2>
    </div>
    <div class="card-body">
        <form action="/animal/update/{{ animal.id }}" method="POST">
            <div class="mb-3">
                <label for="type" class="form-label">Type</label>
                <input type="text" class="form-control" id="type" name="type" value="{{ animal.type }}" required>
            </div>
            <div class="mb-3">
                <label for="age" class="form-label">Âge</label>
                <input type="number" class="form-control" id="age" name="age" value="{{ animal.age }}" required>
            </div>
            <div class="mb-3">
                <label for="sante" class="form-label">État de Santé</label>
                <select class="form-select" id="sante" name="sante" required>
                    <option value="Excellent" {% if animal.sante == 'Excellent' %}selected{% endif %}>Excellent</option>
                    <option value="Bon" {% if animal.sante == 'Bon' %}selected{% endif %}>Bon</option>
                    <option value="Moyen" {% if animal.sante == 'Moyen' %}selected{% endif %}>Moyen</option>
                    <option value="Mauvais" {% if animal.sante == 'Mauvais' %}selected{% endif %}>Mauvais</option>
                </select>
            </div>
            <div class="mb-3">
                <label for="equipment_id" class="form-label">Équipement</label>
                <select class="form-select" id="equipment_id" name="equipment_id">
                    <option value="">Aucun équipement</option>
                    {% for equipment in equipments %}
                        <option value="{{ equipment.id }}" 
                            {% if animal.equipment and animal.equipment.id == equipment.id %}selected{% endif %}>
                            {{ equipment.nom }}
                        </option>
                    {% endfor %}
                </select>
            </div>
            <div class="d-flex justify-content-between">
                <a href="/animal" class="btn btn-secondary">Retour</a>
                <button type="submit" class="btn btn-primary">Mettre à jour</button>
            </div>
        </form>
    </div>
</div>
{% endblock %} 