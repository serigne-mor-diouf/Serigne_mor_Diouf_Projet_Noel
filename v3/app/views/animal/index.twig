{% extends "layout/base.twig" %}

{% block title %}Liste des Animaux{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2>Liste des Animaux</h2>
        <a href="/animal/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouvel Animal
        </a>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Type</th>
                    <th>Âge</th>
                    <th>Santé</th>
                    <th>Équipement</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for animal in animals %}
                <tr>
                    <td>{{ animal.id }}</td>
                    <td>{{ animal.type }}</td>
                    <td>{{ animal.age }} ans</td>
                    <td>{{ animal.sante }}</td>
                    <td>{{ animal.equipment ? animal.equipment.nom : 'Aucun' }}</td>
                    <td>
                        <a href="/animal/edit/{{ animal.id }}" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a href="/animal/delete/{{ animal.id }}" class="btn btn-danger btn-sm" 
                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet animal ?')">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %} 