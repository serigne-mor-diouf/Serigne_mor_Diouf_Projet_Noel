{% extends "layout/base.twig" %}

{% block title %}Liste des Équipements{% endblock %}

{% block content %}
<div class="card">
    <div class="card-header d-flex justify-content-between align-items-center">
        <h2>Liste des Équipements</h2>
        <a href="/equipment/create" class="btn btn-primary">
            <i class="fas fa-plus"></i> Nouveau
        </a>
    </div>
    <div class="card-body">
        <table class="table">
            <thead>
                <tr>
                    <th>ID</th>
                    <th>Nom</th>
                    <th>État</th>
                    <th>Disponibilité</th>
                    <th>Actions</th>
                </tr>
            </thead>
            <tbody>
                {% for equipment in equipments %}
                <tr>
                    <td>{{ equipment.id }}</td>
                    <td>{{ equipment.nom }}</td>
                    <td>{{ equipment.etat }}</td>
                    <td>
                        {% if equipment.disponibilite %}
                            <span class="badge bg-success">Disponible</span>
                        {% else %}
                            <span class="badge bg-danger">Non disponible</span>
                        {% endif %}
                    </td>
                    <td>
                        <a href="/equipment/edit/{{ equipment.id }}" class="btn btn-warning btn-sm">
                            <i class="fas fa-edit"></i>
                        </a>
                        <a href="/equipment/delete/{{ equipment.id }}" class="btn btn-danger btn-sm" 
                           onclick="return confirm('Êtes-vous sûr de vouloir supprimer cet équipement ?')">
                            <i class="fas fa-trash"></i>
                        </a>
                    </td>
                </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>
</div>
{% endblock %} 